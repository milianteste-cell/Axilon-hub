-- ========== FUNÇÕES ==========
local function updateDistance()
    if not startPosition or not humanoidRootPart then return end
    local distance = (humanoidRootPart.Position - startPosition).Magnitude
    distanceLabel.Text = string.format("%.1f studs", distance)
end

local function resetMeasurement()
    startPosition = nil
    isMeasuring = false
    actionButton.Text = "Marcar Posição"
    actionButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    distanceLabel.Text = "0.0 studs"
    statusLabel.Text = "Aguardando..."
end

actionButton.MouseButton1Click:Connect(function()
    if not isMeasuring then
        if humanoidRootPart then
            startPosition = humanoidRootPart.Position
            isMeasuring = true
            actionButton.Text = "Resetar"
            actionButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
            distanceLabel.Text = "0.0 studs"
            statusLabel.Text = "Medindo... ande para ver a distância"
        end
    else
        resetMeasurement()
    end
end)

